# --- required -------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
# PostgreSQL. Percent-encode special characters in the password (@ -> %40, / -> %2F ...).
DATABASE_URL=postgres://aria2c_admin:CHANGE_ME@222.222.222.5:5432/aria2c

# --- web ------------------------------------------------------------------
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://panel.example.com
DJANGO_TIME_ZONE=Asia/Jakarta
# Behind a TLS terminating reverse proxy:
# DJANGO_BEHIND_PROXY=1
# DJANGO_SECURE_COOKIES=1
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=32   # workers x threads = simultaneous live event streams (SSE)

# Optional, decouples the stored RPC secrets from DJANGO_SECRET_KEY:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=

# --- first run (idempotent, only used while no admin / server exists) --------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-too
DJANGO_SUPERUSER_EMAIL=admin@example.com
ARIA2_NAME=default
ARIA2_RPC_URL=http://aria2:6800/jsonrpc
ARIA2_RPC_SECRET=change-me-three

# --- compose helpers ----------------------------------------------------------
# PANEL_PORT=8000
# DOWNLOADS_DIR=./downloads
